# Copy this file to .env and fill in your own values. Never commit .env.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: Groq LLM for the tutor and quiz generation (https://console.groq.com/keys).
# Without it, the app falls back to local retrieval and the built-in question bank.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: YouTube Data API v3 for live video search.
# Without it, videos come from data/catalogs/youtube_videos_catalog.csv.
YOUTUBE_API_KEY=
